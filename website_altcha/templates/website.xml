<data>
    <template
        id="contactus_captcha"
        inherit_id="website.contactus"
        name="Use captcha"
        customize_show="True"
    >
        <xpath expr="//div[hasclass('s_website_form_submit')]" position="before">
            <div class="mb-0 py-2">
                <div class="row s_col_no_resize s_col_no_bgcolor">
                    <div
                        style="width: 200px"
                        class="col-form-label col-sm-auto s_website_form_label"
                    />
                    <div class="col-sm">
                        <t t-call="website_altcha.widget_altcha" />
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</data>
